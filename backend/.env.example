# Copia este archivo como .env (solo para correr la API fuera de Docker).
# Genera cada secreto con:  python -c "import secrets; print(secrets.token_hex(32))"

# Rol sin privilegios: lo usa la API.
DATABASE_URL=postgresql+psycopg://limpieza_app:CAMBIAR@localhost:5432/limpieza
# Rol dueño del esquema: solo lo usan Alembic y la semilla.
MIGRATION_DATABASE_URL=postgresql+psycopg://limpieza_owner:CAMBIAR@localhost:5432/limpieza

# Mínimo 32 caracteres cada uno.
JWT_SECRETO=
FOTOS_FIRMA_SECRETO=

# Carpeta local de fotos, fuera de OneDrive.
FOTOS_DIR=C:/limpieza-fotos

# Clave de los usuarios que crea scripts/semilla.py (solo desarrollo).
SEMILLA_CLAVE=

# Orígenes permitidos por CORS (JSON). Vacío si el frontend usa el proxy /api.
CORS_ORIGENES=["http://localhost:3000"]

# Pruebas de integración contra el contenedor db-test (docker compose -f docker-compose.test.yml up -d --wait).
TEST_DATABASE_URL=postgresql+psycopg://limpieza_app:app_test@127.0.0.1:55432/limpieza_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://limpieza_owner:owner_test@127.0.0.1:55432/limpieza_test
