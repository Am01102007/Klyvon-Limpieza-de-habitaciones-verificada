# Variables de docker-compose.yml. Copia este archivo como .env y completa cada valor.
# Genera cada secreto con:  openssl rand -hex 32
# Usa solo letras y números en las contraseñas: van dentro de una URL de conexión.

# Local: http://localhost   ·   EC2: tu dominio o <ip-con-guiones>.sslip.io (ej. 3-15-20-7.sslip.io)
DOMINIO=http://localhost

# PostgreSQL: superusuario del contenedor y los dos roles del proyecto.
POSTGRES_PASSWORD=
OWNER_PASSWORD=
APP_PASSWORD=

# API: mínimo 32 caracteres cada uno.
JWT_SECRETO=
FOTOS_FIRMA_SECRETO=

# Clave de los usuarios de demostración que crea la semilla (solo si la corres).
SEMILLA_CLAVE=

# produccion oculta /docs y activa HSTS en la API.
ENTORNO=produccion
